rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test doc
    match /test/{docId} {
      allow read: if true;
    }

    // User profile: only the user themselves can read or write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User CVs subcollection: only the user themselves can manage their CVs
      match /cvs/{cvId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Contact messages: anyone can submit, developer and users can read
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read: if true;
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
