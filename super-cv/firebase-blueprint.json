{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents an authenticated user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "sessionExpiresAt": { "type": "string" },
        "lastActiveAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "CandidateCV": {
      "title": "CandidateCV",
      "description": "A tailored candidate CV record belonging to a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "targetRole": { "type": "string" },
        "trackId": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "linkedin": { "type": "string" },
        "summary": { "type": "string" },
        "atsScore": { "type": "number" },
        "matchRate": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Messages sent through the contact form to developer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "recipient": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "message", "recipient", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles"
    },
    "/users/{userId}/cvs/{cvId}": {
      "schema": "CandidateCV",
      "description": "Stores candidate CVs belonging to the authenticated user"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Stores contact messages sent to the developer"
    }
  }
}
